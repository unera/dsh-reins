{
  "name": "@dr-co/dsh-reins",
  "productName": "Reins",
  "version": "0.2.0",
  "description": "A window to any DeepSeek Harness: local or remote, with tabs, theme and a proxy",
  "type": "module",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": "UNera",
  "homepage": "https://github.com/unera/dsh-reins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unera/dsh-reins.git"
  },
  "bugs": {
    "url": "https://github.com/unera/dsh-reins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "electron",
    "desktop",
    "tabs"
  ],
  "bin": {
    "reins": "bin/reins.js"
  },
  "files": [
    "src",
    "bin",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.config.mjs",
    "dist:linux": "electron-builder --config electron-builder.config.mjs --linux",
    "dist:win": "electron-builder --config electron-builder.config.mjs --win",
    "dist:mac": "electron-builder --mac"
  },
  "optionalDependencies": {
    "electron": "^38.0.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {}
}
